				{
					"name": "Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const response = pm.response.json();",
									"const token = response.token || response.access_token || null;",
									"const expiresIn = response.expires_in || 3600; // Adjust if your API gives a different field",
									"",
									"if (token) {",
									"    pm.globals.set(\"tokenBankApps\", token);",
									"",
									"    // Optional: Set expiry timestamp (milliseconds)",
									"    const now = Date.now();",
									"    const expiryTime = now + expiresIn * 1000;",
									"    pm.globals.set(\"tokenBankAppsExpiry\", expiryTime);",
									"",
									"    console.log(\"Token saved to environment\");",
									"} else {",
									"    console.error(\"Token not found in response:\", response);",
									"}",
									""
								],
								"type": "text/javascript",
								"packages": {}
							}
						}
					],
